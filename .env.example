# App
APP_ENV=development
APP_NAME=Teacher Assistant
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Database
POSTGRES_DB=teacher_assistant
POSTGRES_USER=teacher_assistant
POSTGRES_PASSWORD=teacher_assistant_dev_password
DATABASE_URL=postgresql+psycopg://teacher_assistant:teacher_assistant_dev_password@postgres:5432/teacher_assistant

# Redis / RQ
REDIS_URL=redis://redis:6379/0
RQ_DEFAULT_QUEUE=teacher-assistant-default
# Optional stable name used by the Windows pilot worker shutdown workflow.
RQ_WORKER_NAME=

# Storage adapter
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/data
UPLOADS_DIR=/data/uploads
ARTIFACTS_DIR=/data/artifacts
EXPORTS_DIR=/data/exports

# Brain Adapter (the only AI boundary)
# BRAIN_PROVIDER options: mock | gemini | openai | codex_cli | llama_cpp_qwen | llama_cpp_qwen38
BRAIN_PROVIDER=mock
BRAIN_ALLOW_REAL_PROVIDERS=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_IMAGE_INPUT_ENABLED=false
OPENAI_TIMEOUT_SECONDS=30

# Local AI services (Windows host milestone; disabled unless a teacher explicitly acts)
LOCAL_QWEN_ENABLED=false
# Deliberately NOT 8080. A separate Qwen3.6 coding-assistant bridge commonly
# runs there with the same llama-server.exe, and sharing the port makes the two
# contend for one single-slot server. The operator scripts read the port from
# this URL, so this is the single place it is defined.
LOCAL_QWEN_BASE_URL=http://127.0.0.1:8086/v1
LOCAL_QWEN_MODEL=qwen3.6-35b-a3b-q4km
LOCAL_QWEN_API_KEY=
LOCAL_QWEN_TIMEOUT_SECONDS=600
LOCAL_PADDLE_OCR_ENABLED=false
LOCAL_PADDLE_OCR_BASE_URL=http://127.0.0.1:8090
LOCAL_PADDLE_OCR_API_KEY=
LOCAL_PADDLE_OCR_TIMEOUT_SECONDS=900
LOCAL_PADDLE_OCR_MAX_IMAGE_BYTES=20971520
LOCAL_PADDLE_OCR_MODEL=PaddleOCR-VL-1.6
LOCAL_PADDLE_OCR_LAYOUT_MODEL=PP-DocLayoutV3
LOCAL_QWEN38_ENABLED=false
LOCAL_QWEN38_BASE_URL=http://127.0.0.1:8085/v1
LOCAL_QWEN38_MODEL=qwen3.8-27b-q4km
LOCAL_QWEN38_API_KEY=
# Measured on real hardware (RTX 5070, ngl=40/64, CPU/GPU hybrid offload):
# sustained decode ~4.35 tok/s, well below a naive full-GPU assumption.
# A 6500-token reference-bundle ceiling needs ~25 minutes at that rate;
# 1800s covers it with margin. Lower only if your hardware measures faster.
LOCAL_QWEN38_TIMEOUT_SECONDS=1800
# Qwen3.8 visual reference bundles need room for page-image tokens and a
# schema-constrained response. Values below 12288 can truncate multi-page
# JSON. Read by both Start-LocalAi.ps1 (the server's -c flag) and the backend
# (to size the reference-bundle completion budget) — keep them in sync.
LOCAL_QWEN38_CONTEXT_TOKENS=12288
# Host-only performance controls. The defaults preserve the measured RTX 5070
# rollback profile. Use gpu-layers=auto with a 1024 MiB target for auto-fit.
LOCAL_QWEN38_GPU_LAYERS=34
LOCAL_QWEN38_FIT_TARGET_MIB=
LOCAL_QWEN38_THREADS=12
LOCAL_QWEN38_THREADS_BATCH=12
LOCAL_QWEN38_BATCH_SIZE=256
LOCAL_QWEN38_UBATCH_SIZE=256
LOCAL_QWEN38_CPU_MASK=
LOCAL_QWEN38_CPU_MASK_BATCH=
# Optional publisher MTP draft head. Zero keeps speculative decoding disabled.
LOCAL_QWEN38_MTP_MODEL_PATH=
LOCAL_QWEN38_MTP_SHA256=
LOCAL_QWEN38_SPEC_DRAFT_TOKENS=0
LOCAL_QWEN38_VISUAL_PREPARATION_ENABLED=false
LOCAL_QWEN38_TRANSCRIPTION_ENABLED=false
# Qwen3.8 is an explicit visual-transcription rescue only in the supported
# teacher workflow. This historical switch must remain false.
LOCAL_QWEN38_GRADING_ENABLED=false
# Set to off for the pilot unless the locked evaluation explicitly promotes low.
LOCAL_QWEN38_GRADING_REASONING_MODE=off
# Optional operator verification hashes; never commit model files.
LOCAL_QWEN38_MODEL_SHA256=
LOCAL_QWEN38_MMPROJ_SHA256=
LOCAL_QWEN38_MAX_VISUAL_CALLS=25
LOCAL_REFERENCE_EXTRACTION_ENABLED=false
LOCAL_SCRIPT_PREPARATION_ENABLED=false
LOCAL_SCRIPT_MAX_OCR_CALLS=25
LOCAL_SINGLE_ANSWER_GRADING_ENABLED=false
LOCAL_AI_PHASE_SWITCH_ENABLED=false
LOCAL_AI_PHASE_TIMEOUT_SECONDS=600
LOCAL_REFERENCE_MAX_OCR_CALLS=20
# Must stay above LOCAL_QWEN38_TIMEOUT_SECONDS so the HTTP client times out
# with a diagnosable error before RQ hard-kills the whole job.
LOCAL_REFERENCE_JOB_TIMEOUT_SECONDS=2400
COHORT_MODEL_GRADING_ENABLED=false
COHORT_MAX_PROVIDER_CALLS=25
COHORT_PROVIDER_RETRY_COUNT=0
COHORT_DISPATCH_HEARTBEAT_TIMEOUT_SECONDS=600

# Operator scripts only. Keep machine-specific values in an ignored .env file.
LOCAL_QWEN_BINARY_PATH=
LOCAL_QWEN_MODEL_PATH=
LOCAL_PADDLE_OCR_PYTHON_PATH=
LOCAL_PADDLE_OCR_VL_MODEL_PATH=
LOCAL_PADDLE_OCR_LAYOUT_MODEL_PATH=
LOCAL_PADDLE_OCR_DEVICE=gpu:0
LOCAL_PADDLE_OCR_HOST=127.0.0.1
LOCAL_PADDLE_OCR_PORT=8090
LOCAL_QWEN38_BINARY_PATH=
LOCAL_QWEN38_MODEL_PATH=
# JWT_SECRET_KEY must be overridden to a real secret whenever APP_ENV != development;
# the backend refuses to start otherwise.
JWT_SECRET_KEY=dev-only-change-me
JWT_EXPIRE_MINUTES=480
# Comma-separated list of origins allowed to call this API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://host.docker.internal:3000
CODEX_CLI_COMMAND=codex
CODEX_CLI_MODEL=gpt-5.5
CODEX_CLI_TIMEOUT_SECONDS=300
CODEX_CLI_SANDBOX=read-only
CODEX_CLI_APPROVAL_POLICY=never
CODEX_CLI_USE_JSON=true
CODEX_CLI_OUTPUT_LAST_MESSAGE=true
CODEX_CLI_IMAGE_INPUT_ENABLED=false
CODEX_CLI_WORKDIR=/home/newton/teacher-assistant
CODEX_CLI_SKIP_GIT_REPO_CHECK=false

# QUESTION_IMPORT_PROVIDER options: mock | codex_cli_question_extractor
QUESTION_IMPORT_PROVIDER=mock
CODEX_QUESTION_EXTRACTION_ENABLED=false
CODEX_EXTRACTION_ENABLED=false
# CODEX_EXTRACTION_PROVIDER options include disabled | mock | host_bridge_codex |
# gemini. The legacy variable name is retained for compatibility.
CODEX_EXTRACTION_PROVIDER=disabled
CODEX_EXTRACTION_BRIDGE_COMMAND=
CODEX_EXTRACTION_HOST_STORAGE_ROOT=/home/newton/teacher-assistant/data
CODEX_BROWSER_GRADING_ENABLED=false

# Logging
LOG_LEVEL=INFO

# Gemini Provider (used when BRAIN_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_IMAGE_INPUT_ENABLED=false
